# Optional overrides, set as process environment variables (the CLI does not auto-load .env files;
# use your shell, direnv or VS Code's envFile). Every Environment field maps to FOMO_<FIELD_NAME>.
# Normally `uv run fomo env pull --resource-group <rg>` is all you need.
# No keys or secrets here: all access is Microsoft Entra ID (az login).
FOMO_TENANT_ID=
FOMO_SUBSCRIPTION_ID=
FOMO_RESOURCE_GROUP=
FOMO_FOUNDRY_ACCOUNT_NAME=
FOMO_PROJECT_NAME=
FOMO_STORAGE_ACCOUNT_NAME=
FOMO_SEARCH_SERVICE_NAME=
FOMO_CHAT_DEPLOYMENT=gpt-5-mini
# Model name behind the chat deployment, if it differs from the deployment name (knowledge base planner).
# FOMO_CHAT_MODEL=gpt-5-mini
# Smart RAG knowledge base query planning: low | medium (default medium).
# FOMO_KB_REASONING_EFFORT=medium
FOMO_EMBEDDING_DEPLOYMENT=text-embedding-3-small
FOMO_DECISION_DEPLOYMENT=decision-1-1

# Gated live tests (pytest -m integration / -m e2e). Incur small costs.
# FOMO_LIVE=1
# FOMO_TEST_PARTICIPANT=testfox
# FOMO_E2E=1
