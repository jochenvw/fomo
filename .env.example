# Optional overrides, set as process environment variables (the CLI does not auto-load .env files;
# use your shell, direnv or VS Code's envFile). Every Environment field maps to CONTOSO_<FIELD_NAME>.
# Normally `uv run contoso env pull --resource-group <rg>` is all you need.
# No keys or secrets here: all access is Microsoft Entra ID (az login).
CONTOSO_SUBSCRIPTION_ID=
CONTOSO_RESOURCE_GROUP=
CONTOSO_FOUNDRY_ACCOUNT_NAME=
CONTOSO_PROJECT_NAME=
CONTOSO_STORAGE_ACCOUNT_NAME=
CONTOSO_SEARCH_SERVICE_NAME=
CONTOSO_CHAT_DEPLOYMENT=gpt-5-mini
CONTOSO_EMBEDDING_DEPLOYMENT=text-embedding-3-small
CONTOSO_DECISION_DEPLOYMENT=decision-1

# Gated live tests (pytest -m integration / -m e2e). Incur small costs.
# CONTOSO_LIVE=1
# CONTOSO_TEST_PARTICIPANT=testfox
# CONTOSO_E2E=1
